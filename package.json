{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "import:contentful": "tsx scripts/import-contentful.ts",
    "import:books": "tsx scripts/import-books.ts",
    "vercel-build": "node scripts/migrate.mjs && tsx scripts/seed.ts && next build",
    "build:seed": "esbuild scripts/seed.ts scripts/import-contentful.ts --bundle --platform=node --target=node22 --format=esm --outdir=scripts --out-extension:.js=.bundle.mjs --log-level=warning --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "0.8.3",
    "highlight.js": "^11.12.0",
    "jose": "^6.2.13",
    "marked": "^18.1.1",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.4.0",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4",
    "next": "15.5.28",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "playwright": "1.56.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.0"
}
