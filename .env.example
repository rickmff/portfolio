# Copy to .env next to docker-compose.yml on the VPS (or .env.local for local dev).
# On Vercel, set these in Project → Settings → Environment Variables instead: SESSION_SECRET,
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, ADMIN_EMAIL, CONTENT_API_TOKEN, SITE_URL and the
# optional keys. DOMAIN is Docker-only. The Turso integration (or you) sets TURSO_DATABASE_URL and
# TURSO_AUTH_TOKEN, and connecting a Blob store injects BLOB_READ_WRITE_TOKEN, which switches
# uploads from the local disk to Vercel Blob.
DOMAIN=example.com
# /admin login: openssl rand -base64 48
SESSION_SECRET=
# Google sign-in for /admin (OAuth client, redirect URI https://<DOMAIN>/admin/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The only Google account allowed into /admin
ADMIN_EMAIL=rickmff@gmail.com
# Token for the content API used by the portfolio-content skill: openssl rand -hex 32
CONTENT_API_TOKEN=
# Optional: Google Books API key (Cloud console, "Books API") so book pages find previews server-side
GOOGLE_BOOKS_API_KEY=
# Optional: GitHub token (fine-grained, no permissions needed) for the home page contribution graph.
# Without it the graph is read from your public github.com profile, which works too.
GITHUB_TOKEN=

# Public URL of the site (Vercel only; docker compose builds it from DOMAIN)
SITE_URL=https://example.com

# Database: Turso (libsql://<db>-<org>.turso.io + a token from `turso db tokens create <db>`).
# Leave both empty to use a local SQLite file instead (DATABASE_URL, default file:./data/portfolio.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# DATABASE_URL=file:./data/portfolio.db

# Only for the one-off copy from the old Postgres (pnpm migrate:turso)
PG_URL=

# Only for the one-off import from the old site (pnpm import:contentful)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
