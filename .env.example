# Copy to .env next to docker-compose.yml on the VPS (or .env.local for local dev).
DOMAIN=example.com
POSTGRES_PASSWORD=change-me
# Token for the content API used by the portfolio-content skill: openssl rand -hex 32
CONTENT_API_TOKEN=

# Local dev only (docker compose builds this from the values above)
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio

# Only for the one-off import from the old site (pnpm import:contentful)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
